{
    "files.associations": {
        "*.shader": "hlsl",
        "*.compute": "hlsl",
        "*.cginc": "hlsl",
        "*.hlsl": "hlsl",
        "*.asmdef": "json",
        "*.asmref": "json",
        "*.inputactions": "json"
    },
    "files.exclude": {
        "**/.git": true,
        "**/.DS_Store": true,
        "**/Library": true,
        "**/Temp": true,
        "**/Logs": true,
        "**/UserSettings": true,
        "**/obj": true,
        "**/*.meta": false
    },
    "search.exclude": {
        "**/Library": true,
        "**/Temp": true,
        "**/Logs": true,
        "**/Packages": true,
        "**/*.asset": true,
        "**/*.unity": true,
        "**/*.prefab": true
    },
    "csharp.referencesCodeLens.enabled": true,
    "csharp.maxProjectFileCountForDiagnosticAnalysis": 10000,
    "omnisharp.enableRoslynAnalyzers": true,
    "omnisharp.enableImportCompletion": true,
    "omnisharp.enableDecompilationSupport": true,
    "editor.formatOnSave": true,
    "editor.formatOnType": true,
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.rulers": [120],
    "[meta]": {
        "editor.formatOnSave": false
    },
    "dotnet.defaultSolution": "Project-Seal-Stamp.slnx"
}